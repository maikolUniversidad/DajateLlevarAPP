{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": { "EXPO_PUBLIC_API_URL": "http://localhost:3000/api" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false },
      "env": { "EXPO_PUBLIC_API_URL": "https://dajate-llevar-app.vercel.app/api" }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": { "EXPO_PUBLIC_API_URL": "https://dajate-llevar-app.vercel.app/api" }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal"
      },
      "ios": {
        "appleId": "REEMPLAZA_CON_TU_APPLE_ID",
        "ascAppId": "REEMPLAZA_CON_EL_APP_ID_DE_APP_STORE_CONNECT",
        "appleTeamId": "REEMPLAZA_CON_TU_TEAM_ID"
      }
    }
  }
}
