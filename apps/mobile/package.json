{
  "name": "@dejatellevar/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "web": "expo start --web --port 8081",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "eas:init": "eas init",
    "prebuild": "expo prebuild --clean",
    "build:preview": "eas build --platform all --profile preview",
    "build:android": "eas build --platform android --profile production",
    "build:ios": "eas build --platform ios --profile production",
    "build:all": "eas build --platform all --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "submit:ios": "eas submit --platform ios --profile production"
  },
  "dependencies": {
    "@babel/runtime": "7.26.0",
    "@dejatellevar/client": "workspace:^",
    "@dejatellevar/contracts": "workspace:*",
    "@expo/metro-runtime": "4.0.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/netinfo": "11.4.1",
    "@tanstack/query-async-storage-persister": "5.62.16",
    "@tanstack/react-query": "5.62.16",
    "@tanstack/react-query-persist-client": "5.62.16",
    "expo": "52.0.0",
    "expo-constants": "17.0.0",
    "expo-linear-gradient": "14.0.1",
    "expo-linking": "7.0.0",
    "expo-router": "4.0.0",
    "expo-status-bar": "2.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.5",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "4.4.0",
    "react-native-web": "0.19.13"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
