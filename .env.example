# ============================================================================
# DÉJATELLEVAR — variables de entorno (plantilla)
# Copia este archivo a .env.local y rellena los valores reales.
# NUNCA subas .env ni .env.local a git (están en .gitignore).
# Todas las variables se validan con Zod al arrancar (packages/config/env).
# ============================================================================

# --- Entorno ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api

# --- Base de datos (Postgres estándar) -------------------------------------
# Local (docker-compose): postgres://postgres:postgres@localhost:5432/dejatellevar
# Supabase (Connect > pooler): TRANSACTION pooler (6543) para la app/serverless,
#   SESSION pooler (5432) para migraciones. Formato:
#   postgresql://postgres.[REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dejatellevar
# Conexión para migraciones / seed (session pooler 5432 en Supabase):
DATABASE_URL_DIRECT=postgres://postgres:postgres@localhost:5432/dejatellevar

# --- Supabase (adaptadores: Auth + Storage) --------------------------------
# Panel del proyecto > Connect / Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave publishable (nuevo formato sb_publishable_..., reemplaza a la anon key):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
# Clave de la base de datos de Supabase (Project Settings > Database):
SUPABASE_DB_PASSWORD=tu-clave-de-base-de-datos

# --- Cifrado de tokens/campos sensibles (payout_account, external_connection) ---
# Genera con: openssl rand -base64 32
ENCRYPTION_KEY=cambia-esto-por-32-bytes-en-base64

# --- Autenticación / sesión ------------------------------------------------
AUTH_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# --- Pagos: Wompi (PaymentProvider). Stripe NO opera en Colombia. ----------
WOMPI_PUBLIC_KEY=pub_test_xxx
WOMPI_PRIVATE_KEY=prv_test_xxx
WOMPI_EVENTS_SECRET=test_events_xxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxx

# --- IA (LLMProvider) — proveedores directos OpenAI-compatible -------------
# Adaptador: @dejatellevar/ai. Proveedor por defecto: deepseek | openai.
AI_DEFAULT_PROVIDER=deepseek
# DeepSeek (https://platform.deepseek.com) — API compatible con OpenAI.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# OpenAI (https://platform.openai.com).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Opcional: Vercel AI Gateway (enrutado/fallback de modelos).
AI_GATEWAY_API_KEY=

# --- Observabilidad (opcional) ---------------------------------------------
SENTRY_DSN=
