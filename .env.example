# ============================================================================
# DÉJATELLEVAR — variables de entorno (plantilla)
# Copia este archivo a .env.local y rellena los valores reales.
# NUNCA subas .env ni .env.local a git (están en .gitignore).
# Todas las variables se validan con Zod al arrancar (packages/config/env).
# ============================================================================

# --- Entorno ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api

# --- Base de datos (Postgres estándar) -------------------------------------
# Local (docker-compose): postgres://postgres:postgres@localhost:5432/dejatellevar
# Supabase: usa la "Connection string" del proyecto (pooler, puerto 6543 para app,
#           5432 directo para migraciones). Reemplaza [PASSWORD] por la clave real.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dejatellevar
# Conexión directa (migraciones / seed, sin pgbouncer):
DATABASE_URL_DIRECT=postgres://postgres:postgres@localhost:5432/dejatellevar

# --- Supabase (adaptadores: Auth + Storage) --------------------------------
# Panel del proyecto > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
# Clave de la base de datos de Supabase (Project Settings > Database):
SUPABASE_DB_PASSWORD=tu-clave-de-base-de-datos

# --- Cifrado de tokens/campos sensibles (payout_account, external_connection) ---
# Genera con: openssl rand -base64 32
ENCRYPTION_KEY=cambia-esto-por-32-bytes-en-base64

# --- Autenticación / sesión ------------------------------------------------
AUTH_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# --- Pagos: Wompi (PaymentProvider). Stripe NO opera en Colombia. ----------
WOMPI_PUBLIC_KEY=pub_test_xxx
WOMPI_PRIVATE_KEY=prv_test_xxx
WOMPI_EVENTS_SECRET=test_events_xxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxx

# --- IA (LLMProvider) — AI Gateway o proveedor directo ---------------------
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=

# --- Observabilidad (opcional) ---------------------------------------------
SENTRY_DSN=
